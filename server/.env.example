# CampusLens API — copy to .env and fill in. Never commit the real .env.

# MongoDB Atlas connection string
MONGO_URI=

# Google Gemini (embeddings + generation)
GEMINI_API_KEY=

# Pinecone vector store
PINECONE_API_KEY=
PINECONE_INDEX=

# Secret used to sign session tokens. REQUIRED in production — the server
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Locally it falls back to a fixed development key if unset.
JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS in production.
# Leave blank for local dev (the client uses the same-origin Vite proxy).
# Example: CORS_ORIGIN=https://campuslens.vercel.app
CORS_ORIGIN=

# Port the API listens on. Hosts (Render) set this automatically; 3000 locally.
PORT=3000

# Max PDF upload size in megabytes (optional; defaults to 15).
MAX_UPLOAD_MB=15

# Retrieval tuning (optional; sensible defaults live in code).
# SOURCE_SCORE_THRESHOLD=0.55
# MIN_CONTEXT_SCORE=0.55

# How many tokens of hidden reasoning chat may spend before answering
# (optional; defaults to 1024). 0 = fastest first word, weakest multi-step math.
# Raise for harder derivations, lower if answers feel too slow to start.
# CHAT_THINKING_BUDGET=1024
